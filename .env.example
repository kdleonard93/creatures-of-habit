# Database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LOCAL_DATABASE_URL=file:local.db

# PostHog Analytics
PUBLIC_POSTHOG_KEY=
# Release tag attached to analytics and error events (for example the git SHA).
APP_RELEASE=
# Client-side equivalent of APP_RELEASE, exposed to the browser build.
VITE_APP_RELEASE=

# Resend Email Service
RESEND_API_KEY=
# From address for outbound email.
SENDER_EMAIL=

# Runtime
# Trust x-forwarded-for / x-real-ip for the client IP (set true behind a proxy).
TRUST_PROXY=false
# Start the background task scheduler outside production.
ENABLE_SCHEDULER=false

# Canonical Base URL (for email links and assets)
# Development: http://localhost:5175
# Production: https://yourdomain.com
CANONICAL_BASE_URL=http://localhost:5175