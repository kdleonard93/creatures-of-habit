{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Creatures of Habit",
  "version": "0.1.0",
  "identifier": "com.creaturesofhabit.app",
  "build": {
    "frontendDist": "../desktop",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "pnpm run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://creatures-of-habit-production.up.railway.app; connect-src 'self' https://creatures-of-habit-production.up.railway.app; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Gamified habit tracking",
    "longDescription": "Creatures of Habit is a gamified habit tracking application that helps users build consistent routines by leveling up a creature as they complete real-life habits.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
